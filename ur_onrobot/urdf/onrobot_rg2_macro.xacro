<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="onrobot_rg2" params="prefix parent *origin">
    
    <!-- Joint to attach the gripper to the parent -->
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
    </joint>

    <!-- Gripper Base -->
    <link name="${prefix}gripper_base_link">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.1 0.1"/>
        </geometry>
        <material name="Grey">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.1 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.7"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Left Finger -->
    <link name="${prefix}left_finger">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.01 0.1"/>
        </geometry>
        <material name="DarkGrey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.01 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Right Finger -->
    <link name="${prefix}right_finger">
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.01 0.1"/>
        </geometry>
        <material name="DarkGrey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.01 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Joints for fingers -->
    <joint name="${prefix}finger_joint" type="prismatic">
      <origin xyz="0 0.05 0.1" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}left_finger"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.04" effort="50" velocity="0.2"/>
    </joint>

    <!-- Not a mimic joint: MoveIt and the trajectory controller only command
         actuated joints, so both fingers are driven with the same target. -->
    <joint name="${prefix}right_finger_joint" type="prismatic">
      <origin xyz="0 -0.05 0.1" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}right_finger"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="50" velocity="0.2"/>
    </joint>


    <ros2_control name="${prefix}gripper" type="system">
      <hardware>
        <plugin>ign_ros2_control/IgnitionSystem</plugin>
      </hardware>
      <joint name="${prefix}finger_joint">
        <command_interface name="position" />
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}right_finger_joint">
        <command_interface name="position" />
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo reference="${prefix}left_finger">
      <mu1>1000.0</mu1>
      <mu2>1000.0</mu2>
      <minDepth>0.003</minDepth>
      <maxVel>0.0</maxVel>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
    </gazebo>
    <gazebo reference="${prefix}right_finger">
      <mu1>1000.0</mu1>
      <mu2>1000.0</mu2>
      <minDepth>0.003</minDepth>
      <maxVel>0.0</maxVel>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
    </gazebo>

  </xacro:macro>

</robot>
