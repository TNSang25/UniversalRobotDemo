<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="ur3e_sorting_world">
    
    <!-- Các plugin cốt lõi -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <!-- Ánh sáng -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -0.9</direction>
    </light>

    <!-- Mặt đất -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================= BÀN (TABLE) ======================= -->
    <model name="table">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.6 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= VỊ TRÍ ĐẶT ROBOT ================= -->
    <!-- Khi spawn UR3e hãy dùng tọa độ này: X = -0.35, Y = 0.0, Z = 0.8 -->

    <!-- ======================= CUBES ======================= -->
    <!-- Nằm trên mặt bàn, phía trước các khay. Nếu đổi vị trí thì phải sửa
         ur_task_planner/config/scene.yaml cho khớp. -->
    <model name="red_cube">
      <static>false</static>
      <pose>-0.10 0.0 0.825 0 0 0.5</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>2.08e-5</ixx><iyy>2.08e-5</iyy><izz>2.08e-5</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000.0</mu>
                <mu2>1000.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="yellow_cube">
      <static>false</static>
      <pose>-0.10 -0.15 0.825 0 0 -0.2</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>2.08e-5</ixx><iyy>2.08e-5</iyy><izz>2.08e-5</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000.0</mu>
                <mu2>1000.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <static>false</static>
      <pose>-0.10 0.15 0.825 0 0 1.0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>2.08e-5</ixx><iyy>2.08e-5</iyy><izz>2.08e-5</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000.0</mu>
                <mu2>1000.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======================= KHAY ĐÍCH (MÀU XÁM) ======================= -->
    <!-- Tâm khay ở X = 0.05, khớp với zones trong ur_task_planner/config/scene.yaml -->
    <model name="tray_A">
      <static>true</static>
      <pose>0.05 0.15 0.805 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tray_B">
      <static>true</static>
      <pose>0.05 0.0 0.805 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tray_C">
      <static>true</static>
      <pose>0.05 -0.15 0.805 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.01</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======================= CHỮ KHẮC TRÊN BÀN ======================= -->
    <!-- Đã dịch chuyển ra xa tương ứng, X = 0.28 -->
    
    <model name="letter_A">
      <static>true</static>
      <pose>0.18 0.2 0.801 0 0 0</pose> 
      <link name="link">
        <visual name="left_leg">
          <pose>0 0.015 0 0 0 0</pose>
          <geometry><box><size>0.06 0.01 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="right_leg">
          <pose>0 -0.015 0 0 0 0</pose>
          <geometry><box><size>0.06 0.01 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="top_bar">
          <pose>0.025 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.04 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="mid_bar">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.04 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="letter_B">
      <static>true</static>
      <pose>0.18 0.0 0.801 0 0 0</pose>
      <link name="link">
        <visual name="spine">
          <pose>0 0.015 0 0 0 0</pose>
          <geometry><box><size>0.06 0.01 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="top_bar">
          <pose>0.025 -0.005 0 0 0 0</pose>
          <geometry><box><size>0.01 0.03 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="mid_bar">
          <pose>0 -0.005 0 0 0 0</pose>
          <geometry><box><size>0.01 0.03 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="bot_bar">
          <pose>-0.025 -0.005 0 0 0 0</pose>
          <geometry><box><size>0.01 0.03 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="right_top">
          <pose>0.0125 -0.015 0 0 0 0</pose>
          <geometry><box><size>0.015 0.01 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="right_bot">
          <pose>-0.0125 -0.015 0 0 0 0</pose>
          <geometry><box><size>0.015 0.01 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="letter_C">
      <static>true</static>
      <pose>0.18 -0.2 0.801 0 0 0</pose>
      <link name="link">
        <visual name="spine">
          <pose>0 0.015 0 0 0 0</pose>
          <geometry><box><size>0.06 0.01 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="top_bar">
          <pose>0.025 -0.005 0 0 0 0</pose>
          <geometry><box><size>0.01 0.03 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
        <visual name="bot_bar">
          <pose>-0.025 -0.005 0 0 0 0</pose>
          <geometry><box><size>0.01 0.03 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>